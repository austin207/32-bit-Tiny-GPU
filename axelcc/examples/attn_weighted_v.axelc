// Phase 5.1 stage 3: out = weights * V  (Q8 fixed-point, seq_len=4, d_model=4)
//
// Thread i owns query row i. out[i][k] is the Q16 dot product of the
// softmax weight row i with column k of V, rescaled to Q8 with one SAR
// after the full accumulation -- same convention as attn_scores.
//
// Memory layout (base addresses supplied by the caller via the kernel
// parameter ABI, so one compiled binary is reusable across heads):
//   v_base+0..15       V[4][4]        (input, row-major, V[j][k] at v_base + j*4+k)
//   weights_base+0..15 weights[4][4]  (input, row-major, weights_base + i*4+j)
//   out_base+0..15     out[4][4]      (output, row-major, out_base + i*4+k)
kernel void attn_weighted_v(int v_base, int weights_base, int out_base) {
    int i = threadIdx;
    for (int k = 0; k < 4; k++) {
        int sum = 0;
        for (int j = 0; j < 4; j++) {
            int w = mem[weights_base + i * 4 + j];
            int v = mem[v_base + j * 4 + k];
            sum = sum + w * v;
        }
        mem[out_base + i * 4 + k] = sum >> 8;
    }
}
